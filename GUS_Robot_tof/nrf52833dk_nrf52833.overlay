&arduino_i2c {
	status = "okay";
	compatible = "nordic,nrf-twim";
	zephyr,concat-buf-size = <4096>;

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		label = "SSD1306";
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
	sht4x@44 {
		compatible = "sensirion,sht4x"; 
		reg = <0x44>;                   
		label = "SHT4X";           
		status = "okay";              
		repeatability = <2>;         
	};

	vcnl4040@60 {
		status = "okay";
		compatible = "vishay,vcnl4040";
		reg = <0x60>;
		led-current = <200>;
		led-duty-cycle = <320>;
	};
};

&uart0 {
    
    status = "okay";
    current-speed = <9600>;
    mhz19b:winsen-mhz19b {
        compatible = "winsen,mhz19b";
        maximum-range = <5000>;
        label = "MH-Z19B";
    };
};

/* For Node Configuration only*/
&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 14)>, //6   for nrf52dk5832 / 5840
				<NRF_PSEL(UART_RX, 0, 15)>,   //8	  for nrf52dk5832
				<NRF_PSEL(UART_RTS, 0, 5)>,
				<NRF_PSEL(UART_CTS, 0, 7)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 14)>,    //6
				<NRF_PSEL(UART_RX, 0, 15)>,        //8
				<NRF_PSEL(UART_RTS, 0, 5)>,
				<NRF_PSEL(UART_CTS, 0, 7)>;
			low-power-enable;
		};
	};
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 32)>,  
				<NRF_PSEL(TWIM_SCL, 0, 31)>;      
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 32)>,   
				<NRF_PSEL(TWIM_SCL, 0, 31)>;        
			low-power-enable;
		};
	};
};