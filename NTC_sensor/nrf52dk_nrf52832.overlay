/* nrf52840_ntc.overlay */

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1";  /* Adjust gain as needed */
        zephyr,reference = "ADC_REF_INTERNAL"; /* 0.6V ref for nRF SAADC */
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN1>; /* P0.03 */
        zephyr,resolution = <12>;
    };
};
/ {
    zephyr,user {
        io-channels = <&adc 0>;
    };

};

